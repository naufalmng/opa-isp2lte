#!/usr/bin/env bash
#
# oitl — OPA-ISP2LTE command-line interface.
# "Opa jagain internet lo, biar nggak mati."
#
# Subcommands:
#   oitl install / uninstall
#   oitl config [get|set|list]
#   oitl status / log [-f] / switch <isp|lte|auto> / restart

set -u

VERSION="1.0.0"
CONF="/etc/opa-isp2lte.conf"
SERVICE="opa-isp2lte.service"
DAEMON="/usr/local/sbin/opa-isp2lte.sh"

# ===== color (auto-detect TTY) =====
if [ -t 1 ] && [[ " $* " != *" --no-color "* ]]; then
    C_RESET=$'\033[0m';  C_BOLD=$'\033[1m';  C_DIM=$'\033[2m'
    C_GREEN=$'\033[0;32m'; C_YELLOW=$'\033[0;33m'; C_CYAN=$'\033[0;36m'; C_RED=$'\033[0;31m'
else
    C_RESET="" C_BOLD="" C_DIM="" C_GREEN="" C_YELLOW="" C_CYAN="" C_RED=""
fi

ok()   { printf '%s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
err()  { printf '%s✗%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }

die() { err "$1"; echo "Run 'oitl --help' for usage." >&2; exit 1; }

need_root() { [ "$EUID" -eq 0 ] || die "This command needs root (sudo)."; }

# ===== config helpers =====
config_get() {
    local key="$1"
    grep -E "^${key}=" "$CONF" 2>/dev/null | head -1 | cut -d= -f2-
}
config_set() {
    local key="$1" val="$2"
    need_root
    [ -f "$CONF" ] || { echo "# OPA-ISP2LTE configuration" > "$CONF"; }
    if grep -qE "^${key}=" "$CONF"; then
        sed -i "s|^${key}=.*|${key}=${val}|" "$CONF"
    else
        echo "${key}=${val}" >> "$CONF"
    fi
    ok "${key} = ${val}"
}

# ===== logo (pure-bash gradient) =====
LOGO_PLAIN=' ██████╗ ██████╗  █████╗       ██╗███████╗██████╗ ██████╗ ██╗  ████████╗███████╗
██╔═══██╗██╔══██╗██╔══██╗      ██║██╔════╝██╔══██╗╚════██╗██║  ╚══██╔══╝██╔════╝
██║   ██║██████╔╝███████║█████╗██║███████╗██████╔╝ █████╔╝██║     ██║   █████╗
██║   ██║██╔═══╝ ██╔══██║╚════╝██║╚════██║██╔═══╝ ██╔═══╝ ██║     ██║   ██╔══╝
╚██████╔╝██║     ██║  ██║      ██║███████║██║     ███████╗███████╗██║   ███████╗
 ╚═════╝ ╚═╝     ╚═╝  ╚═╝      ╚═╝╚══════╝╚═╝     ╚══════╝╚══════╝╚═╝   ╚══════╝'

banner() {
    local line w i r g b ch
    if [ -z "$C_CYAN" ]; then printf '%s\n' "$LOGO_PLAIN"; else
        w=$(printf '%s\n' "$LOGO_PLAIN" | awk '{ if (length($0) > m) m=length($0) } END { print m }')
        while IFS= read -r line; do
            for ((i=0; i<${#line}; i++)); do
                ch="${line:i:1}"
                if [ "$ch" = " " ]; then printf ' '; else
                    r=$(( i * 255 / (w > 1 ? w - 1 : 1) )); g=$(( 255 - r )); b=255
                    printf '\033[38;2;%d;%d;%dm%s\033[0m' "$r" "$g" "$b" "$ch"
                fi
            done
            printf '\n'
        done <<< "$LOGO_PLAIN"
    fi
}

# ===== usage =====
usage() {
    banner
    echo
    cat <<EOF
${C_BOLD}oitl${C_RESET} — OPA-ISP2LTE control (ISP <-> LTE failover)  ${C_DIM}v${VERSION}${C_RESET}

${C_BOLD}Usage:${C_RESET}
  oitl <command> [options]

${C_BOLD}Commands:${C_RESET}
  install              Install service + daemon (interactive)
  uninstall            Remove service + daemon + config
  status               Show current failover status
  log [-f]             Show log (with -f to follow)
  switch <isp|lte|auto>  Manually switch path, or return to auto
  config [get|set|list]  View or change configuration
  restart              Restart the daemon

${C_BOLD}Examples:${C_RESET}
  oitl install
  oitl status
  oitl config set INTERVAL 5
  oitl config list
  oitl switch lte
  oitl log -f

${C_BOLD}Options:${C_RESET}
  -h, --help           Show this help
  -V, --version        Show version

EOF
}

# ===== subcommands =====
cmd_status() {
    echo "${C_BOLD}OPA-ISP2LTE status${C_RESET}"
    echo
    if systemctl is-active --quiet "$SERVICE" 2>/dev/null; then
        ok "daemon: ${C_GREEN}running${C_RESET}"
    else
        warn "daemon: not running"
    fi

    echo
    echo "Active route:"
    ip route show default 2>/dev/null | head -5 || echo "  (no default route)"

    echo
    echo "Links:"
    for iface in $(config_get PRIMARY) $(config_get BACKUP); do
        if [ -z "$iface" ]; then continue; fi
        if [ -e "/sys/class/net/$iface/carrier" ] && [ "$(cat /sys/class/net/$iface/carrier 2>/dev/null)" = "1" ]; then
            printf '  %s %-16s %s\n' "${C_GREEN}●${C_RESET}" "$iface" "up"
        else
            printf '  %s %-16s %s\n' "${C_RED}●${C_RESET}" "$iface" "down"
        fi
    done
}

cmd_log() {
    local follow=0
    [ "${1:-}" = "-f" ] && follow=1
    local logfile
    logfile=$(config_get LOGFILE); logfile="${logfile:-/var/log/opa-isp2lte.log}"
    if [ "$follow" = "1" ]; then
        tail -f "$logfile"
    else
        tail -n 30 "$logfile" 2>/dev/null || err "No log at $logfile"
    fi
}

cmd_switch() {
    need_root
    local target="${1:-}"
    local primary backup pgw bgw
    primary=$(config_get PRIMARY); backup=$(config_get BACKUP)
    pgw=$(config_get PRIMARY_GW); bgw=$(config_get BACKUP_GW)

    case "$target" in
        isp|primary)  ip route del default 2>/dev/null; ip route add default via "$pgw" dev "$primary" && ok "Switched to ISP ($primary)";;
        lte|backup)   ip route del default 2>/dev/null; ip route add default via "$bgw" dev "$backup" && ok "Switched to LTE ($backup)";;
        auto)         systemctl restart "$SERVICE" && ok "Returned to auto (daemon restarted)";;
        "")           die "switch needs a target: isp|lte|auto";;
        *)           die "Unknown switch target '$target'. Valid: isp|lte|auto";;
    esac
}

cmd_config() {
    local sub="${1:-list}"
    case "$sub" in
        list|get|show|"")
            [ -f "$CONF" ] || die "Config not found at $CONF (run 'oitl install' first)."
            echo "${C_BOLD}Configuration ($CONF):${C_RESET}"
            grep -vE '^\s*(#|$)' "$CONF" | sed 's/^/  /'
            ;;
        set)
            local key="$2" val="$3"
            [ -n "$key" ] || die "Usage: oitl config set <KEY> <VALUE>"
            [ -n "$val" ] || die "Missing value. Usage: oitl config set <KEY> <VALUE>"
            case "$key" in
                PRIMARY|BACKUP|PRIMARY_GW|BACKUP_GW|INTERVAL|FAIL_THRESHOLD|FAILBACK_HOLD|LOGFILE) config_set "$key" "$val";;
                PING_TARGETS) config_set "$key" "$val";;
                *) die "Unknown config key '$key'. Valid: PRIMARY, BACKUP, PRIMARY_GW, BACKUP_GW, PING_TARGETS, INTERVAL, FAIL_THRESHOLD, FAILBACK_HOLD, LOGFILE";;
            esac
            warn "Restart daemon to apply: oitl restart"
            ;;
        *) die "Unknown config subcommand '$sub'. Valid: list|set";;
    esac
}

cmd_restart() {
    need_root
    systemctl restart "$SERVICE" && ok "daemon restarted"
}

cmd_install() {
    need_root
    echo "${C_BOLD}Installing OPA-ISP2LTE...${C_RESET}"
    echo
    echo "This requires the installer. Run instead:"
    echo "  ${C_CYAN}curl -fsSL <URL>/install.sh | sudo bash${C_RESET}"
    echo
    warn "CLI-only install is not yet wired here — use install.sh."
    exit 1
}

cmd_uninstall() {
    need_root
    systemctl disable --now "$SERVICE" 2>/dev/null
    rm -f /usr/local/sbin/opa-isp2lte.sh /usr/local/bin/oitl /usr/local/bin/opa-isp2lte
    warn "Daemon, CLI, and symlink removed. Config kept at $CONF (delete manually if desired)."
    ok "uninstalled"
}

# ===== dispatch =====
case "${1:-}" in
    ""|-h|--help|help)   usage ;;
    -V|--version|version) echo "oitl (OPA-ISP2LTE) v${VERSION}" ;;
    status)              cmd_status ;;
    log)                 cmd_log "${2:-}" ;;
    switch)              cmd_switch "${2:-}" ;;
    config)              cmd_config "${2:-}" "${3:-}" "${4:-}" ;;
    restart)             cmd_restart ;;
    install)             cmd_install ;;
    uninstall)           cmd_uninstall ;;
    *)                   die "Unknown command '${1:-}'. Run 'oitl --help'." ;;
esac
